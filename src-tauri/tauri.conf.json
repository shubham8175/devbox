{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DevBox",
  "version": "../package.json",
  "identifier": "in.co.voyra.devbox",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DevBox",
        "width": 1280,
        "height": 840,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true,
        "fullscreen": false,
        "create": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' blob: data: https:",
        "font-src": "'self'",
        "media-src": "'self' blob:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://ipwho.is https://ipinfo.io https://api.ipify.org https://api64.ipify.org",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Developer tools that run in your browser.",
    "longDescription": "Free developer tools for JSON, APIs, regex, JWTs, images and more. Everything is processed locally, and no account is required.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.3"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
